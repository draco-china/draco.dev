{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "navigation",
  "main": "server/entry.cloudflare.js",
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "compatibility_date": "2026-09-11",
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "navigation",
      "preview_database_id": "NAVIGATION_DB",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "ICONS", "bucket_name": "navigation" }],
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "observability": {
    "enabled": true
  },
  "account_id": "adff9630a2d4065492eda15f771e1f90"
}

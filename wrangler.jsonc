{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "draco-dev",
  "main": "apps/desktop/server/entry.cloudflare.js",
  "compatibility_date": "2026-09-11",
  "assets": {
    "directory": "apps/desktop/dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true
  },
  "services": [
    {
      "binding": "NAVIGATION",
      "service": "navigation"
    }
  ],
  "account_id": "adff9630a2d4065492eda15f771e1f90",
  "workers_dev": false,
  "preview_urls": false,
  "triggers": {
    "crons": []
  }
}

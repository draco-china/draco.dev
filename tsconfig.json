{
  "compilerOptions": {
    "allowJs": true,
    "types": ["bun", "vite/client"],
    "target": "es2020",
    "module": "esnext",
    "lib": ["es2022", "DOM", "WebWorker", "DOM.Iterable"],
    "jsx": "react-jsx",
    "jsxImportSource": "@qwik.dev/core",
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "incremental": true,
    "isolatedModules": true,
    "outDir": "tmp",
    "noEmit": true
  },
  "include": ["apps", "packages", "scripts", "tests", "./*.config.ts"],
  "exclude": [
    "node_modules",
    "**/node_modules",
    "**/dist",
    "tmp",
    ".vitest",
    ".local-retired",
    "apps/navigation/server",
    "apps/navigation/worker-configuration.d.ts",
    "apps/desktop/server"
  ]
}
